<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Chuyện Tình Yêu | <%= weddingData.groom.firstName %> & <%=
      weddingData.bride.firstName %>
    </title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&family=Raleway:wght@300;400&display=swap");
      body {
        font-family: "Raleway", sans-serif;
        color: #5c5c5c;
        margin: 0;
        background: #fff9fb;
      }
      .container {
        max-width: 900px;
        margin: auto;
      }
      .section {
        padding: 60px 20px;
        text-align: center;
      }
      h1,
      h2 {
        font-family: "Dancing Script", cursive;
        font-weight: 600;
      }
      h2 {
        font-size: 3rem;
        color: #e67a8b;
        margin-bottom: 20px;
      }
      .hero {
        position: relative;
        text-align: center;
        color: white;
      }
      .hero img {
        width: 100%;
        height: 100vh;
        object-fit: cover;
        filter: brightness(0.8);
      }
      .hero-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
      }
      .hero-text h1 {
        font-size: 6rem;
        margin: 0;
      }
      .couple-intro img {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
      }
      .album-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
      }
      .album-grid img {
        width: 250px;
        height: 350px;
        object-fit: cover;
        border-radius: 120px 120px 5px 5px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      }
      .event-card {
        background: white;
        border-radius: 10px;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <div class="hero">
      <img src="<%= weddingData.coupleImage %>" alt="Couple" />
      <div class="hero-text">
        <p>We're Getting Married</p>
        <h1>
          <%= weddingData.groom.firstName %> & <%= weddingData.bride.firstName
          %>
        </h1>
        <p><%= weddingData.weddingDate %></p>
      </div>
    </div>
    <div class="container">
      <% if (weddingData.groom.introduction || weddingData.bride.introduction) {
      %>
      <div class="section">
        <h2>Our Story Begins With</h2>
        <div
          style="
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 40px;
            align-items: center;
          "
        >
          <% if (weddingData.groom.introduction) { %>
          <div>
            <img src="<%= weddingData.groom.image %>" alt="Chú rể" />
            <h3 style="font-family: 'Dancing Script', cursive; font-size: 2rem">
              <%= weddingData.groom.fullName %>
            </h3>
            <p style="max-width: 300px; margin: auto; font-style: italic">
              <%= weddingData.groom.introduction %>
            </p>
          </div>
          <% } %> <% if (weddingData.bride.introduction) { %>
          <div>
            <img src="<%= weddingData.bride.image %>" alt="Cô dâu" />
            <h3 style="font-family: 'Dancing Script', cursive; font-size: 2rem">
              <%= weddingData.bride.fullName %>
            </h3>
            <p style="max-width: 300px; margin: auto; font-style: italic">
              <%= weddingData.bride.introduction %>
            </p>
          </div>
          <% } %>
        </div>
      </div>
      <% } %> <% if (weddingData.album && weddingData.album.length > 0) { %>
      <div class="section">
        <h2>Sweet Moments</h2>
        <div class="album-grid">
          <% weddingData.album.forEach(image => { %>
          <img src="<%= image %>" alt="Ảnh cưới" />
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </body>
</html>
