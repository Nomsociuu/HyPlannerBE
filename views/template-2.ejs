<!DOCTYPE html>
<html lang="vi" style="scroll-behavior: smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Save the Date | <%= weddingData.groom.firstName %> & <%=
      weddingData.bride.firstName %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary-color: #2c5d63; /* Màu xanh cổ vịt */
        --secondary-color: #f0ebe3; /* Màu be nhạt */
        --text-dark: #333333;
        --text-light: #555555;
        --bg-color: #ffffff;
        --font-heading: "Poppins", sans-serif;
        --font-body: "Roboto", sans-serif;
      }

      body {
        font-family: var(--font-body);
        margin: 0;
        padding: 0;
        background-color: var(--bg-color);
        color: var(--text-dark);
        line-height: 1.7;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 80px 20px;
      }

      /* --- Header & Hero Section --- */
      .hero {
        min-height: 100vh;
        background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)),
          url("<%= weddingData.coupleImage %>") no-repeat center center/cover;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 20px;
      }

      .hero h3 {
        font-family: var(--font-heading);
        font-weight: 300;
        font-size: 1.5rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0;
      }

      .hero h1 {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 4rem;
        margin: 10px 0;
      }

      .hero p.full-names {
        font-family: var(--font-heading);
        font-size: 1.8rem;
        margin-top: 15px;
        margin-bottom: 5px;
      }

      /* --- Countdown Timer --- */
      #countdown {
        display: flex;
        gap: 20px;
        margin-top: 30px;
      }

      .countdown-item {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 15px 25px;
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
      }

      .countdown-item span {
        display: block;
        font-family: var(--font-heading);
        font-size: 2.5rem;
        font-weight: 600;
      }

      .countdown-item p {
        margin: 0;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      /* --- Section Styling --- */
      .section-heading {
        text-align: center;
        margin-bottom: 60px;
      }

      .section-heading h2 {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        font-weight: 600;
        color: var(--primary-color);
        position: relative;
        display: inline-block;
        padding-bottom: 10px;
      }

      .section-heading h2::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 50%;
        height: 3px;
        background-color: var(--primary-color);
      }

      /* --- YouTube Video --- */
      .video-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
        height: 0;
        overflow: hidden;
        max-width: 800px;
        margin: 0 auto 50px auto;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      }

      .video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* --- Love Story Timeline --- */
      .timeline {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
      }
      .timeline::after {
        content: "";
        position: absolute;
        width: 3px;
        background-color: var(--secondary-color);
        top: 0;
        bottom: 0;
        left: 50%;
        margin-left: -1.5px;
      }
      .timeline-item {
        padding: 10px 40px;
        position: relative;
        background-color: inherit;
        width: 50%;
      }
      .timeline-item::after {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        right: -10px;
        background-color: white;
        border: 4px solid var(--primary-color);
        top: 25px;
        border-radius: 50%;
        z-index: 1;
      }
      .left {
        left: 0;
      }
      .right {
        left: 50%;
      }
      .right::after {
        left: -10px;
      }
      .timeline-content {
        padding: 20px 30px;
        background-color: var(--secondary-color);
        border-radius: 8px;
      }
      .timeline-content h3 {
        font-family: var(--font-heading);
        color: var(--primary-color);
      }
      .timeline-content .story-image {
        /* Style for potential love story images */
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 6px;
        margin-bottom: 15px;
      }

      /* --- Events Section --- */
      .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
      }
      .event-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
      }
      .event-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
      }
      .event-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
      }
      .event-details {
        padding: 25px;
      }
      .event-details h3 {
        font-family: var(--font-heading);
        color: var(--primary-color);
        margin-top: 0;
      }
      .event-details p {
        margin: 5px 0;
        color: var(--text-light);
      }
      .event-details a {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 500;
      }

      /* --- Album Section --- */
      .album-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
      }
      .album-grid img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.3s, opacity 0.3s;
      }
      .album-grid img:hover {
        transform: scale(1.05);
        opacity: 0.8;
      }

      /* --- Guestbook Section --- */
      .guestbook-message {
        background-color: #fff;
        padding: 20px;
        border-left: 5px solid var(--primary-color);
        border-radius: 8px;
        margin-bottom: 20px;
      }
      .guestbook-message p {
        margin: 0;
        font-style: italic;
      }
      .guestbook-message .name {
        font-weight: bold;
        font-style: normal;
        margin-top: 10px;
        color: var(--primary-color);
        text-align: right;
      }
      .guestbook-form {
        margin-top: 50px;
      }
      .form-group {
        margin-bottom: 20px;
      }
      .form-group input,
      .form-group textarea {
        width: 100%;
        padding: 15px;
        border: 1px solid #746565;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 1rem;
        box-sizing: border-box;
      }
      .submit-btn {
        width: 100%;
        padding: 15px;
        border: none;
        background-color: var(--primary-color);
        color: white;
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s;
      }
      .submit-btn:hover {
        background-color: #1e3f43;
      }

      /* --- Footer --- */
      footer {
        text-align: center;
        padding: 40px;
        background-color: var(--secondary-color);
        margin-top: 80px;
      }
      footer p {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        color: var(--primary-color);
        margin: 0;
      }

      /* --- Responsive Design --- */
      @media (max-width: 768px) {
        .hero h1 {
          font-size: 3rem;
        }
        .hero p.full-names {
          font-size: 1.4rem;
        }
        .countdown-item {
          padding: 10px 15px;
          gap: 10px;
        }
        .countdown-item span {
          font-size: 2rem;
        }
        .timeline::after {
          left: 10px;
        }
        .timeline-item {
          width: 100%;
          padding-left: 40px;
          padding-right: 15px;
        }
        .timeline-item::after {
          left: 0;
        }
        .left,
        .right {
          left: 0%;
        }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <h3>We Are Getting Married</h3>
      <h1>
        <%= weddingData.groom.firstName %> & <%= weddingData.bride.firstName %>
      </h1>
      <p class="full-names">
        <%= weddingData.groom.fullName %> & <%= weddingData.bride.fullName %>
      </p>
      <p><%= weddingData.weddingDate %></p>
      <div id="countdown">
        <div class="countdown-item">
          <span id="days">00</span>
          <p>Days</p>
        </div>
        <div class="countdown-item">
          <span id="hours">00</span>
          <p>Hours</p>
        </div>
        <div class="countdown-item">
          <span id="minutes">00</span>
          <p>Minutes</p>
        </div>
        <div class="countdown-item">
          <span id="seconds">00</span>
          <p>Seconds</p>
        </div>
      </div>
    </header>

    <main>
      <section id="video" class="container">
        <div class="section-heading">
          <h2>Our Story Video</h2>
        </div>
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube.com/embed/<%= weddingData.youtubeUrl.split('v=')[1] %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          >
          </iframe>
        </div>
      </section>

      <section id="story" class="container">
        <div class="section-heading">
          <h2>Our Love Story</h2>
        </div>
        <div class="timeline">
          <% weddingData.loveStory.forEach(function(story, index) { %>
          <div class="timeline-item <%= index % 2 === 0 ? 'left' : 'right' %>">
            <div class="timeline-content">
              <h3><%= story.title %></h3>
              <p><strong><%= story.time %>:</strong> <%= story.content %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </section>

      <section id="events" style="background-color: var(--secondary-color)">
        <div class="container">
          <div class="section-heading">
            <h2>Wedding Events</h2>
          </div>
          <div class="events-grid">
            <% weddingData.events.forEach(function(event) { %>
            <div class="event-card">
              <img src="<%= event.image %>" alt="<%= event.name %>" />
              <div class="event-details">
                <h3><%= event.name %></h3>
                <p><strong>Thời gian:</strong> <%= event.time %></p>
                <p><strong>Địa điểm:</strong> <%= event.venue %></p>
                <p><strong>Địa chỉ:</strong> <%= event.address %></p>
                <% if (event.mapLink) { %>
                <p>
                  <a href="<%= event.mapLink %>" target="_blank"
                    >Xem bản đồ &rarr;</a
                  >
                </p>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section id="album" class="container">
        <div class="section-heading">
          <h2>Our Album</h2>
        </div>
        <div class="album-grid">
          <% weddingData.album.forEach(function(image) { %>
          <img src="<%= image %>" alt="Ảnh cưới" />
          <% }); %>
        </div>
      </section>

      <section id="guestbook" style="background-color: var(--secondary-color)">
        <div class="container">
          <div class="section-heading">
            <h2>Guestbook</h2>
          </div>
          <% weddingData.guestbookMessages.forEach(function(message) { %>
          <div class="guestbook-message">
            <p>"<%= message.message %>"</p>
            <p class="name">- <%= message.name %> -</p>
          </div>
          <% }); %>

          <div class="guestbook-form">
            <form>
              <div class="form-group">
                <input
                  type="text"
                  name="name"
                  placeholder="Tên của bạn"
                  required
                />
              </div>
              <div class="form-group">
                <textarea
                  name="message"
                  rows="5"
                  placeholder="Để lại lời chúc của bạn..."
                  required
                ></textarea>
              </div>
              <button type="submit" class="submit-btn">Gửi Lời Chúc</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>
        Chúc phúc <%= weddingData.groom.fullName %> & <%=
        weddingData.bride.fullName %>
      </p>
    </footer>

    <script>
      // JavaScript cho bộ đếm ngược
      (function () {
        // Chuyển đổi chuỗi ngày tháng tiếng Việt sang định dạng Date object
        const weddingDateStr = "<%= weddingData.weddingDate %>"; // "Ngày 03 Tháng 06, 2036"
        const dateParts = weddingDateStr.match(
          /(\d+)\s+Tháng\s+(\d+),\s+(\d+)/
        );
        if (dateParts) {
          const day = parseInt(dateParts[1], 10);
          const month = parseInt(dateParts[2], 10); // Lấy tháng là số (ví dụ: 06 -> 6)
          const year = parseInt(dateParts[3], 10);

          // Tạo đối tượng Date (Lưu ý: tháng trong JS là 0-indexed, nên cần trừ 1)
          const weddingDate = new Date(year, month - 1, day).getTime();

          const countdownFunction = setInterval(function () {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor(
              (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
            );
            const minutes = Math.floor(
              (distance % (1000 * 60 * 60)) / (1000 * 60)
            );
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // Đảm bảo hiển thị 2 chữ số
            document.getElementById("days").innerText =
              days < 10 ? "0" + days : days;
            document.getElementById("hours").innerText =
              hours < 10 ? "0" + hours : hours;
            document.getElementById("minutes").innerText =
              minutes < 10 ? "0" + minutes : minutes;
            document.getElementById("seconds").innerText =
              seconds < 10 ? "0" + seconds : seconds;

            if (distance < 0) {
              clearInterval(countdownFunction);
              document.getElementById("countdown").innerHTML =
                "<h2>The Big Day Is Here!</h2>";
            }
          }, 1000);
        } else {
          console.error("Could not parse wedding date:", weddingDateStr);
          document.getElementById("countdown").innerText = "Date format error.";
        }
      })();
    </script>
  </body>
</html>
