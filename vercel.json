{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "views/**",
        "maxDuration": 10
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/wedding-notifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/task-notifications",
      "schedule": "0 8,18 * * *"
    },
    {
      "path": "/api/cron/table-notifications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/push-countdown",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/push-task-reminder",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/push-random-tip",
      "schedule": "0 15 * * 2,5"
    },
    {
      "path": "/api/cron/push-inactive-reminder",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/push-budget-reminder",
      "schedule": "30 20 * * *"
    }
  ]
}
