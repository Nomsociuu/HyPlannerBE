<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= weddingData.groom.firstName %> & <%= weddingData.bride.firstName %>
    </title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400&display=swap");
      body {
        font-family: "Poppins", sans-serif;
        color: #333;
        margin: 0;
        background: #fff;
        font-weight: 300;
      }
      .container {
        max-width: 1100px;
        margin: auto;
      }
      .section {
        padding: 100px 40px;
      }
      h1,
      h2,
      h3 {
        font-family: "Montserrat", sans-serif;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }
      h2 {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 60px;
      }
      .hero {
        display: flex;
        align-items: center;
        min-height: 100vh;
        background: #f4f4f4;
      }
      .hero-text {
        flex: 1;
        padding: 5%;
      }
      .hero-text h1 {
        font-size: 5rem;
        line-height: 1.1;
      }
      .hero-text .date {
        margin-top: 20px;
        letter-spacing: 3px;
      }
      .hero-image {
        flex: 1;
        height: 100vh;
      }
      .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .album-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }
      .album-grid img {
        width: 100%;
        aspect-ratio: 1/1;
        object-fit: cover;
      }
      .event-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }
      .event-card {
        text-align: left;
      }
      .event-card img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        margin-bottom: 15px;
      }
      .guestbook-form input,
      .guestbook-form textarea {
        border: 2px solid #333;
      }
    </style>
  </head>
  <body>
    <div class="hero">
      <div class="hero-text">
        <h1>
          <%= weddingData.groom.firstName %> & <%= weddingData.bride.firstName
          %>
        </h1>
        <p class="date"><%= weddingData.weddingDate %></p>
      </div>
      <div class="hero-image">
        <img src="<%= weddingData.coupleImage %>" alt="Couple" />
      </div>
    </div>
    <div class="container">
      <% if (weddingData.events && weddingData.events.length > 0) { %>
      <div class="section">
        <h2>The Events</h2>
        <div class="event-grid">
          <% weddingData.events.forEach(event => { %>
          <div class="event-card">
            <img src="<%= event.image %>" alt="<%= event.name %>" />
            <h3><%= event.name %></h3>
            <p><%= event.time %></p>
            <p><strong><%= event.venue %></strong><br /><%= event.address %></p>
            <a
              href="<%= event.mapLink %>"
              target="_blank"
              style="color: #333; text-decoration: underline"
              >View Map</a
            >
          </div>
          <% }) %>
        </div>
      </div>
      <% } %> <% if (weddingData.album && weddingData.album.length > 0) { %>
      <div class="section">
        <h2>Our Album</h2>
        <div class="album-grid">
          <% weddingData.album.forEach(image => { %>
          <img src="<%= image %>" alt="Ảnh cưới" />
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </body>
</html>
